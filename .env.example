# Copy this file to .env and change values as needed.
# Every setting is OPTIONAL - the app runs with the defaults shown here.
# Never commit your real .env file.

# ---- Storage paths ----
TRAFFIC_DB_PATH=data/traffic.db
UPLOAD_DIR=data/uploads
OUTPUT_DIR=outputs
MODELS_DIR=models

# ---- AI model ----
YOLO_MODEL=yolov8n.pt
DEFAULT_CONFIDENCE=0.35

# ---- Upload / resource limits ----
MAX_IMAGE_MB=10
MAX_IMAGE_SIDE=1920
MAX_VIDEO_MB=50
MAX_VIDEO_SECONDS=120
MAX_VIDEO_FRAMES=30

# ---- Congestion indicator (scores are 0-100) ----
CONGESTION_REFERENCE_CAPACITY=30
CONGESTION_MODERATE_THRESHOLD=25
CONGESTION_HIGH_THRESHOLD=50
CONGESTION_SEVERE_THRESHOLD=75

# ---- Fusion engine ----
FUSION_CONGESTION_WEIGHT=0.45
FUSION_INCIDENT_WEIGHT=0.55
FUSION_MEDIUM_THRESHOLD=30
FUSION_HIGH_THRESHOLD=55
FUSION_CRITICAL_THRESHOLD=75

# ---- Optional: PIN required to edit incidents (leave empty for open demo mode) ----
ADMIN_PIN=

# ---- Optional AWS S3 (leave USE_S3=false to store files locally) ----
USE_S3=false
S3_BUCKET=
S3_PREFIX=traffic-demo
AWS_DEFAULT_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

LOG_LEVEL=INFO
