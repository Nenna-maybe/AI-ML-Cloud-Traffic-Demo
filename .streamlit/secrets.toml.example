# Example for Streamlit Community Cloud -> App settings -> Secrets.
# Paste ONLY what you need. Never commit a real secrets.toml file.

ADMIN_PIN = "choose-a-pin"

# Optional AWS S3
USE_S3 = "true"
S3_BUCKET = "your-bucket-name"
S3_PREFIX = "traffic-demo"
AWS_DEFAULT_REGION = "ap-south-1"
AWS_ACCESS_KEY_ID = "your-access-key-id"
AWS_SECRET_ACCESS_KEY = "your-secret-access-key"
